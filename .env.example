# DeployPilot Environment Configuration
# Copy this file to .env and configure real values. Never commit .env to source control.

# Application Server
DEPLOY_PILOT_HOST=0.0.0.0
DEPLOY_PILOT_PORT=8088
DEPLOY_PILOT_LOG_LEVEL=INFO
DEPLOY_PILOT_ENVIRONMENT=production

# Security & Webhook Secrets
# Secret used by GitHub to sign push payloads with HMAC-SHA256
DEPLOY_PILOT_WEBHOOK_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Optional admin API token for protected endpoints (like /deployments)
DEPLOY_PILOT_API_TOKEN=replace_with_a_secure_random_api_token

# Configuration & Paths
DEPLOY_PILOT_CONFIG_FILE=config/repositories.yaml
DEPLOY_PILOT_DATABASE_PATH=data/deploypilot.db

# Deployment Root Whitelist (Path traversal protection)
# Only repositories inside this root directory are authorized to deploy
DEPLOY_PILOT_ALLOWED_DEPLOYMENT_ROOT=/volume1/docker

# Concurrency & Timeouts (Seconds)
DEPLOY_PILOT_MAX_CONCURRENT_BUILDS=1
DEPLOY_PILOT_DEFAULT_TIMEOUT_SECONDS=600
DEPLOY_PILOT_GIT_TIMEOUT_SECONDS=60
DEPLOY_PILOT_HEALTHCHECK_TIMEOUT_SECONDS=120
